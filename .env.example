# Databricks workspace URL, without a trailing slash
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace-me
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/replace-me
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=default
DATABRICKS_VOLUME=walmart_landing

# CSV path relative to the project root (use a new filename for each refresh)
WALMART_CSV_PATH=data/raw/walmart_sales.csv

# Local Airflow UI
AIRFLOW_UID=50000
